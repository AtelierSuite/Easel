    "Web.Status.Preview" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Easel for the web opens, shows and exports images. Painting and editing are on the way."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Web 版 Easel では画像を開いて表示し、書き出すことができます。ペイントと編集は今後対応予定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹용 Easel에서는 이미지를 열고, 보고, 내보낼 수 있습니다. 그리기와 편집은 곧 지원됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网页版 Easel 可以打开、查看和导出图像。绘画和编辑功能即将推出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網頁版 Easel 可以打開、檢視和輸出影像。繪圖和編輯功能即將推出。"
          }
        }
      }
    },
