    "Web.Start.Intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open a Photoshop, Pixelmator Pro or Easel image or any picture, or start a new one. Everything stays on this device."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photoshop、Pixelmator Pro、Easel のファイルや画像を開くか、新しい画像を作成します。データはすべてこのデバイスに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photoshop, Pixelmator Pro 또는 Easel 이미지나 사진을 열거나 새 이미지를 시작하십시오. 모든 데이터는 이 기기에 남습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 Photoshop、Pixelmator Pro 或 Easel 图像或任意图片，或新建图像。所有内容都保留在此设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開 Photoshop、Pixelmator Pro 或 Easel 影像或任何圖片，或新增影像。所有內容都保留在此裝置上。"
          }
        }
      }
    },
