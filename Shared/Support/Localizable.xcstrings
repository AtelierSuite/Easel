    "Error.NoObjectHere": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no object there. Tap a person, animal or thing to select it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこにはオブジェクトがありません。人物、動物、物体をタップして選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그곳에는 개체가 없습니다. 사람, 동물 또는 사물을 탭하여 선택하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
