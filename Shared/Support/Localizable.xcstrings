    "LayerEffects.Empty.Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a shadow, glow, stroke or overlay. Styles follow whatever you paint on the layer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャドウ、光彩、境界線、オーバーレイを追加できます。スタイルはレイヤーに描いた内容に合わせて変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자, 광선, 획 또는 오버레이를 추가하십시오. 스타일은 레이어에 그리는 내용을 따라갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加投影、发光、描边或叠加。样式会跟随你在图层上绘制的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入陰影、光暈、筆畫或覆蓋。樣式會跟隨你在圖層上繪製的內容。"
          }
        }
