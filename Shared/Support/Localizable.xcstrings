    "Intent.Resize.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scales an image to a new width or height, or both."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を新しい幅や高さ、またはその両方に拡大・縮小します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 새 너비나 높이 또는 둘 다로 조절합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将图像缩放到新的宽度、高度或两者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將影像縮放到新的寬度、高度或兩者。"
          }
        }
      }
    },
