          "stringUnit": {
            "state": "translated",
            "value": "고급 개체가 이 파일에 연결되어 있습니다. 파일을 선택하면 고급 개체를 편집할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
