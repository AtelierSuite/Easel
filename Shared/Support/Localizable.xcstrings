    "History.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a step to go back to it. Making a change after going back drops the steps after it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップをタップするとその時点に戻ります。戻った後に変更すると、それ以降のステップは消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단계를 탭하면 해당 시점으로 돌아갑니다. 돌아간 후 변경하면 그 이후의 단계는 사라집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点某一步可返回该步骤。返回后再作更改，会丢弃之后的步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下某個步驟即可返回該步驟。返回後再作更改，會捨棄之後的步驟。"
          }
        }
      }
    },
