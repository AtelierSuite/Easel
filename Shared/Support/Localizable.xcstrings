    "Error.LayerHidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The layer is hidden. Show it to paint on it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーが非表示です。ペイントするには表示してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레이어가 가려져 있습니다. 칠하려면 레이어를 표시하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
