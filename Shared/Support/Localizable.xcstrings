    "Intent.RemoveBackground.Description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the people, animals and objects in an image and makes the rest transparent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像内の人物、動物、物体を残し、それ以外を透明にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지의 사람, 동물, 사물을 남기고 나머지를 투명하게 만듭니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留图像中的人物、动物和物体，其余部分变为透明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留影像中的人物、動物和物體，其餘部分變為透明。"
          }
        }
      }
    },
