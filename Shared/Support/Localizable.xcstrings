    "Adjust.PickNeutral.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap something in the picture that should be gray or white to balance its colors."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グレーや白であるべき箇所をタップすると、色のバランスを整えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회색이나 흰색이어야 하는 곳을 탭하여 색상 균형을 맞추십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点图片中应为灰色或白色的地方以平衡颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下圖片中應為灰色或白色的地方以平衡顏色。"
          }
        }
      }
    },
