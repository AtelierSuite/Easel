    "FilterMask.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The filters show only where the filter mask is white. Paint it with the brush to hide them, and with the eraser to bring them back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルターはフィルターマスクが白い部分にだけ適用されます。ブラシでペイントすると隠れ、消しゴムで戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터는 필터 마스크가 흰색인 곳에만 적용됩니다. 브러시로 칠하면 가려지고 지우개로 되돌릴 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滤镜只在滤镜蒙版为白色的地方显示。用画笔绘制可将其隐藏，用橡皮擦可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "濾鏡只在濾鏡遮色片為白色的地方顯示。用筆刷繪製可將其隱藏，用橡皮擦可恢復。"
          }
        }
      }
    },
