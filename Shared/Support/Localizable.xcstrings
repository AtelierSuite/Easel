    "LayerFilters.Empty.Detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filters change how this layer looks without changing its pixels, so they can be adjusted or removed at any time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルタはピクセルを変更せずにレイヤーの見た目を変えるので、いつでも調整したり取り除いたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터는 픽셀을 변경하지 않고 레이어의 모양을 바꾸므로 언제든지 조절하거나 제거할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滤镜会更改此图层的外观而不更改其像素，因此可以随时调整或移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "濾鏡會更改此圖層的外觀而不更改其像素，因此可以隨時調整或移除。"
          }
        }
      }
    },
