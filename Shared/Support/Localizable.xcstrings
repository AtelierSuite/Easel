    "Error.MaskTool": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the brush, eraser and gradient can paint on a mask."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスクにペイントできるのは、ブラシ、消しゴム、グラデーションだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마스크에는 브러시, 지우개, 그라디언트만 칠할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
