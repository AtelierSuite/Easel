    "Comps.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A comp remembers which layers show, where they sit and how they blend. Tap one to bring it back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カンプはレイヤーの表示、位置、描画モードを記憶します。タップすると元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성은 표시되는 레이어, 위치 및 혼합 방식을 기억합니다. 탭하여 되돌리십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复合会记住哪些图层可见、它们的位置以及混合方式。轻点即可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "構圖會記住哪些圖層可見、位置及混合方式。點一下即可恢復。"
          }
        }
      }
    },
