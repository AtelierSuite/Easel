    "Mask.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While painting on the mask, the brush hides the layer and the eraser reveals it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスクにペイントしている間は、ブラシでレイヤーを隠し、消しゴムで再び表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마스크에 칠하는 동안 브러시는 레이어를 가리고 지우개는 다시 표시합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在蒙版上绘画时，画笔会隐藏图层，橡皮擦会重新显示图层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在遮色片上繪圖時，筆刷會隱藏圖層，橡皮擦會重新顯示圖層。"
          }
        }
