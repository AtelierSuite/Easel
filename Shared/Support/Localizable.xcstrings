    "CanvasSize.Mode.Anchor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Size"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズを維持"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기 유지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持大小"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "維持大小"
          }
        }
      }
    },
    "CanvasSize.Mode.Anchor.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The picture stays the same size. The canvas grows around it or crops it, keeping the picture at the anchor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像のサイズは変わりません。カンバスが画像の周りに広がるか切り取られ、画像は基準点の位置に置かれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 크기는 그대로 유지됩니다. 캔버스가 사진 주변으로 넓어지거나 잘리며, 사진은 기준점에 놓입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片大小保持不变。画布会在图片周围扩展或裁剪，图片保持在锚点位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片大小維持不變。畫布會在圖片周圍擴展或裁切，圖片維持在錨點位置。"
          }
        }
      }
    },
    "CanvasSize.Mode.Proportional": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scale Proportionally"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦横比を保って拡大・縮小"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비율에 맞춰 크기 조절"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等比缩放"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等比例縮放"
          }
        }
      }
    },
    "CanvasSize.Mode.Proportional.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The picture scales evenly to fit inside the new canvas without distortion. Any room left over is placed using the anchor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像は歪まないように縦横比を保ったまま、新しいカンバスに収まるよう拡大・縮小されます。余った部分は基準点に合わせて配置されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 왜곡 없이 새로운 캔버스 안에 맞도록 비율에 맞춰 크기가 조절됩니다. 남는 공간은 기준점에 따라 배치됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片会等比缩放以适合新画布而不变形。剩余空间根据锚点排列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片會等比例縮放以符合新畫布而不變形。剩餘空間會依錨點排列。"
          }
        }
      }
    },
    "CanvasSize.Mode.Stretch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stretch to Fill"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き伸ばして埋める"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "늘려서 채우기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉伸以填充"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "延展以填滿"
          }
        }
      }
    },
    "CanvasSize.Mode.Stretch.Footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The picture is stretched to fill the new canvas exactly, which can change its proportions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像は新しいカンバスにぴったり合うように引き伸ばされます。縦横比が変わる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 새로운 캔버스를 정확히 채우도록 늘어나며, 비율이 바뀔 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片会被拉伸以完全填满新画布，这可能会改变其比例。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片會被延展以完全填滿新畫布，這可能會改變其比例。"
          }
        }
      }
    },
