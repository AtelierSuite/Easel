    "WriteBackLoss.ColorMode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grayscale, CMYK or bitmap color, which Easel keeps as RGB"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グレースケール、CMYK、またはビットマップのカラーモード（EaselではRGBになります）"
